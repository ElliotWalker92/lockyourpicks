# Copy to .env.local and fill in. .env.local is gitignored.

# --- Supabase ---
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS entirely — never prefix with NEXT_PUBLIC_, and never
# import it into anything that renders.
SUPABASE_SERVICE_ROLE_KEY=

# --- API-Football (api-sports.io) ---
# Free tier is 100 requests/day, which is enough IF fixtures are fetched by date
# rather than per-competition. See docs/game-design.md §6a.
API_FOOTBALL_KEY=

# Shared secret for cron routes, so only Vercel Cron can trigger ingestion and
# settlement.
CRON_SECRET=
